diff --git a/drivers/video/bridge/ite-it66121.c b/drivers/video/bridge/ite-it66121.c
new file mode 100644
index 0000000..ffffc7b
--- /dev/null
+++ b/drivers/video/bridge/ite-it66121.c
@@ -0,0 +1,545 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ITE IT66121 HDMI transmitter driver
+ *
+ * Copyright (C) 2026 TOBI contributors
+ *
+ * Adapted from the Linux DRM bridge driver:
+ * Copyright (C) 2020 BayLibre, SAS
+ * Copyright (C) 2018-2019, Artem Mygaiev
+ * Copyright (C) 2017, Fresco Logic, Incorporated
+ *
+ * U-Boot only needs video during boot, so this driver deliberately omits
+ * audio, HDCP, interrupts and runtime hotplug handling. It emits DVI-compatible
+ * TMDS video, which avoids needing HDMI infoframes for the boot console.
+ */
+
+#include <dm.h>
+#include <edid.h>
+#include <i2c.h>
+#include <power/regulator.h>
+#include <video_bridge.h>
+
+#include <asm/gpio.h>
+#include <dm/device_compat.h>
+#include <dm/ofnode_graph.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+
+#define IT66121_VENDOR_ID0_REG			0x00
+#define IT66121_VENDOR_ID1_REG			0x01
+#define IT66121_DEVICE_ID0_REG			0x02
+#define IT66121_DEVICE_ID1_REG			0x03
+#define IT66121_DEVICE_ID1_MASK			GENMASK(3, 0)
+
+#define IT66121_SW_RST_REG			0x04
+#define IT66121_SW_RST_REF			BIT(5)
+#define IT66121_SW_RST_VID			BIT(3)
+#define IT66121_SW_RST_HDCP			BIT(0)
+
+#define IT66121_INT_REG				0x05
+#define IT66121_INT_TX_CLK_OFF			BIT(0)
+
+#define IT66121_SYS_STATUS_REG			0x0e
+#define IT66121_SYS_STATUS_HPDETECT		BIT(6)
+
+#define IT66121_CLK_BANK_REG			0x0f
+#define IT66121_CLK_BANK_PWROFF_RCLK		BIT(6)
+#define IT66121_CLK_BANK_PWROFF_TXCLK		BIT(4)
+
+#define IT66121_MASTER_SEL_REG			0x10
+#define IT66121_MASTER_SEL_HOST			BIT(0)
+#define IT66121_DDC_HEADER_REG			0x11
+#define IT66121_DDC_HEADER_EDID			0xa0
+#define IT66121_DDC_OFFSET_REG			0x12
+#define IT66121_DDC_BYTE_REG			0x13
+#define IT66121_DDC_SEGMENT_REG			0x14
+#define IT66121_DDC_COMMAND_REG			0x15
+#define IT66121_DDC_COMMAND_EDID_READ		0x03
+#define IT66121_DDC_COMMAND_FIFO_CLR		0x09
+#define IT66121_DDC_COMMAND_ABORT		0x0f
+#define IT66121_DDC_STATUS_REG			0x16
+#define IT66121_DDC_STATUS_TX_DONE		BIT(7)
+#define IT66121_DDC_STATUS_NOACK		BIT(5)
+#define IT66121_DDC_STATUS_WAIT_BUS		BIT(4)
+#define IT66121_DDC_STATUS_ARBI_LOSE		BIT(3)
+#define IT66121_DDC_RD_FIFO_REG			0x17
+#define IT66121_DDC_FIFO_SIZE			32
+
+#define IT66121_HDCP_REG			0x20
+#define IT66121_HDCP_CPDESIRED			BIT(0)
+
+#define IT66121_AFE_DRV_REG			0x61
+#define IT66121_AFE_DRV_RST			BIT(4)
+#define IT66121_AFE_DRV_PWD			BIT(5)
+#define IT66121_AFE_XP_REG			0x62
+#define IT66121_AFE_XP_GAINBIT			BIT(7)
+#define IT66121_AFE_XP_PWDPLL			BIT(6)
+#define IT66121_AFE_XP_ENO			BIT(4)
+#define IT66121_AFE_XP_RESETB			BIT(3)
+#define IT66121_AFE_XP_PWDI			BIT(2)
+#define IT66121_AFE_IP_REG			0x64
+#define IT66121_AFE_IP_GAINBIT			BIT(7)
+#define IT66121_AFE_IP_PWDPLL			BIT(6)
+#define IT66121_AFE_IP_ER0			BIT(3)
+#define IT66121_AFE_IP_RESETB			BIT(2)
+#define IT66121_AFE_IP_EC1			BIT(0)
+#define IT66121_AFE_XP_EC1_REG			0x68
+#define IT66121_AFE_XP_EC1_LOWCLK		BIT(4)
+
+#define IT66121_INPUT_MODE_REG			0x70
+#define IT66121_INPUT_MODE_RGB			0
+#define IT66121_INPUT_MODE_DDR			BIT(2)
+#define IT66121_INPUT_CSC_REG			0x72
+#define IT66121_INPUT_CSC_NO_CONV		0
+
+#define IT66121_HDMI_MODE_REG			0xc0
+#define IT66121_AV_MUTE_REG			0xc1
+#define IT66121_AV_MUTE_ON			BIT(0)
+#define IT66121_PKT_GEN_CTRL_REG		0xc6
+
+#define IT66121_VENDOR_ID			0x4954
+#define IT66121_DEVICE_ID			0x0612
+#define IT66121_AFE_CLK_HIGH_KHZ		80000
+#define IT66121_MIN_CLOCK_HZ			25000000
+#define IT66121_MAX_CLOCK_24BIT_HZ		148500000
+
+struct it66121_priv {
+	struct udevice *supplies[3];
+	struct display_timing timing;
+	u32 bus_width;
+	bool have_timing;
+};
+
+static const char *const it66121_supply_names[] = {
+	"vcn33-supply", "vcn18-supply", "vrf12-supply",
+};
+
+static const struct display_timing it66121_fallback_timing = {
+	.pixelclock = { 74250000, 74250000, 74250000 },
+	.hactive = { 1280, 1280, 1280 },
+	.hfront_porch = { 110, 110, 110 },
+	.hback_porch = { 220, 220, 220 },
+	.hsync_len = { 40, 40, 40 },
+	.vactive = { 720, 720, 720 },
+	.vfront_porch = { 5, 5, 5 },
+	.vback_porch = { 20, 20, 20 },
+	.vsync_len = { 5, 5, 5 },
+	.flags = DISPLAY_FLAGS_HSYNC_HIGH | DISPLAY_FLAGS_VSYNC_HIGH |
+		 DISPLAY_FLAGS_DE_HIGH | DISPLAY_FLAGS_PIXDATA_POSEDGE,
+};
+
+static int it66121_update_bits(struct udevice *dev, u8 reg, u8 mask, u8 val)
+{
+	int old;
+
+	old = dm_i2c_reg_read(dev, reg);
+	if (old < 0)
+		return old;
+
+	return dm_i2c_reg_write(dev, reg, (old & ~mask) | (val & mask));
+}
+
+static int it66121_wait_ddc_ready(struct udevice *dev)
+{
+	const u8 error = IT66121_DDC_STATUS_NOACK |
+		IT66121_DDC_STATUS_WAIT_BUS | IT66121_DDC_STATUS_ARBI_LOSE;
+	int i, val;
+
+	for (i = 0; i < 40; i++) {
+		val = dm_i2c_reg_read(dev, IT66121_DDC_STATUS_REG);
+		if (val < 0)
+			return val;
+		if (val & error)
+			return -EAGAIN;
+		if (val & IT66121_DDC_STATUS_TX_DONE)
+			return 0;
+		mdelay(5);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int it66121_abort_ddc(struct udevice *dev)
+{
+	int cpdesire, ret, swreset;
+
+	swreset = dm_i2c_reg_read(dev, IT66121_SW_RST_REG);
+	if (swreset < 0)
+		return swreset;
+	cpdesire = dm_i2c_reg_read(dev, IT66121_HDCP_REG);
+	if (cpdesire < 0)
+		return cpdesire;
+
+	ret = dm_i2c_reg_write(dev, IT66121_HDCP_REG,
+			       cpdesire & ~IT66121_HDCP_CPDESIRED);
+	if (ret)
+		return ret;
+	ret = dm_i2c_reg_write(dev, IT66121_SW_RST_REG,
+			       swreset | IT66121_SW_RST_HDCP);
+	if (ret)
+		return ret;
+	ret = dm_i2c_reg_write(dev, IT66121_MASTER_SEL_REG,
+			       IT66121_MASTER_SEL_HOST);
+	if (ret)
+		return ret;
+	ret = dm_i2c_reg_write(dev, IT66121_DDC_COMMAND_REG,
+			       IT66121_DDC_COMMAND_ABORT);
+	if (ret)
+		return ret;
+
+	return it66121_wait_ddc_ready(dev);
+}
+
+static int it66121_read_edid_block(struct udevice *dev, u8 *buf,
+				   unsigned int block)
+{
+	int count, offset = (block % 2) * EDID_SIZE;
+	int remain = EDID_SIZE;
+	int ret;
+
+	block /= 2;
+	while (remain) {
+		count = min(remain, IT66121_DDC_FIFO_SIZE);
+
+		ret = dm_i2c_reg_write(dev, IT66121_DDC_COMMAND_REG,
+				       IT66121_DDC_COMMAND_FIFO_CLR);
+		if (ret)
+			return ret;
+		ret = it66121_wait_ddc_ready(dev);
+		if (ret)
+			return ret;
+
+		ret = dm_i2c_reg_write(dev, IT66121_DDC_OFFSET_REG, offset);
+		if (ret)
+			return ret;
+		ret = dm_i2c_reg_write(dev, IT66121_DDC_BYTE_REG, count);
+		if (ret)
+			return ret;
+		ret = dm_i2c_reg_write(dev, IT66121_DDC_SEGMENT_REG, block);
+		if (ret)
+			return ret;
+		ret = dm_i2c_reg_write(dev, IT66121_DDC_COMMAND_REG,
+				       IT66121_DDC_COMMAND_EDID_READ);
+		if (ret)
+			return ret;
+
+		ret = it66121_wait_ddc_ready(dev);
+		if (ret) {
+			it66121_abort_ddc(dev);
+			return ret;
+		}
+
+		ret = dm_i2c_read(dev, IT66121_DDC_RD_FIFO_REG, buf, count);
+		if (ret)
+			return ret;
+
+		buf += count;
+		offset += count;
+		remain -= count;
+	}
+
+	return 0;
+}
+
+static int it66121_read_edid(struct udevice *dev, u8 *buf, int buf_size)
+{
+	int ret;
+
+	if (buf_size < EDID_SIZE)
+		return -ENOSPC;
+
+	ret = dm_i2c_reg_write(dev, IT66121_MASTER_SEL_REG,
+			       IT66121_MASTER_SEL_HOST);
+	if (ret)
+		return ret;
+	ret = dm_i2c_reg_write(dev, IT66121_DDC_HEADER_REG,
+			       IT66121_DDC_HEADER_EDID);
+	if (ret)
+		return ret;
+
+	ret = it66121_read_edid_block(dev, buf, 0);
+	if (ret)
+		return ret;
+
+	if (buf_size >= EDID_EXT_SIZE && buf[126]) {
+		ret = it66121_read_edid_block(dev, buf + EDID_SIZE, 1);
+		if (!ret)
+			return EDID_EXT_SIZE;
+	}
+
+	return EDID_SIZE;
+}
+
+static bool it66121_mode_valid(void *data,
+			       const struct display_timing *timing)
+{
+	return timing->pixelclock.typ >= IT66121_MIN_CLOCK_HZ &&
+		timing->pixelclock.typ <= IT66121_MAX_CLOCK_24BIT_HZ &&
+		timing->hactive.typ <= 1920 && timing->vactive.typ <= 1200 &&
+		!(timing->flags & (DISPLAY_FLAGS_INTERLACED |
+				    DISPLAY_FLAGS_DOUBLESCAN));
+}
+
+static int it66121_get_display_timing(struct udevice *dev,
+				      struct display_timing *timing)
+{
+	struct it66121_priv *priv = dev_get_priv(dev);
+	u8 edid[EDID_EXT_SIZE];
+	int bpc, len, ret;
+
+	if (!priv->have_timing) {
+		len = it66121_read_edid(dev, edid, sizeof(edid));
+		if (len > 0)
+			ret = edid_get_timing_validate(edid, len, &priv->timing,
+						       &bpc, it66121_mode_valid,
+						       priv);
+		else
+			ret = len;
+
+		if (ret) {
+			dev_warn(dev, "EDID unavailable (%d), using 1280x720\n", ret);
+			priv->timing = it66121_fallback_timing;
+		}
+		priv->have_timing = true;
+	}
+
+	*timing = priv->timing;
+	return 0;
+}
+
+static int it66121_configure_input(struct udevice *dev)
+{
+	struct it66121_priv *priv = dev_get_priv(dev);
+	u8 mode = IT66121_INPUT_MODE_RGB;
+	int ret;
+
+	if (priv->bus_width == 12)
+		mode |= IT66121_INPUT_MODE_DDR;
+
+	ret = dm_i2c_reg_write(dev, IT66121_INPUT_MODE_REG, mode);
+	if (ret)
+		return ret;
+
+	return dm_i2c_reg_write(dev, IT66121_INPUT_CSC_REG,
+				IT66121_INPUT_CSC_NO_CONV);
+}
+
+static int it66121_configure_afe(struct udevice *dev)
+{
+	struct it66121_priv *priv = dev_get_priv(dev);
+	bool high_clock = priv->timing.pixelclock.typ / 1000 >
+			  IT66121_AFE_CLK_HIGH_KHZ;
+	int ret;
+
+	ret = dm_i2c_reg_write(dev, IT66121_AFE_DRV_REG,
+			       IT66121_AFE_DRV_RST);
+	if (ret)
+		return ret;
+
+	ret = it66121_update_bits(dev, IT66121_AFE_XP_REG,
+				  IT66121_AFE_XP_GAINBIT | IT66121_AFE_XP_ENO,
+				  high_clock ? IT66121_AFE_XP_GAINBIT :
+				  IT66121_AFE_XP_ENO);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_AFE_IP_REG,
+				  IT66121_AFE_IP_GAINBIT | IT66121_AFE_IP_ER0,
+				  high_clock ? IT66121_AFE_IP_GAINBIT :
+				  IT66121_AFE_IP_ER0);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_AFE_IP_REG,
+				  IT66121_AFE_IP_EC1,
+				  high_clock ? 0 : IT66121_AFE_IP_EC1);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_AFE_XP_EC1_REG,
+				  IT66121_AFE_XP_EC1_LOWCLK,
+				  high_clock ? 0 : IT66121_AFE_XP_EC1_LOWCLK);
+	if (ret)
+		return ret;
+
+	ret = it66121_update_bits(dev, IT66121_SW_RST_REG,
+				  IT66121_SW_RST_REF | IT66121_SW_RST_VID, 0);
+	if (ret)
+		return ret;
+
+	return dm_i2c_reg_write(dev, IT66121_AFE_DRV_REG, 0);
+}
+
+static int it66121_attach(struct udevice *dev)
+{
+	int ret;
+
+	if (!dev_get_priv(dev))
+		return -ENODEV;
+
+	/* DVI-compatible TMDS is enough for a video-only U-Boot console. */
+	ret = dm_i2c_reg_write(dev, IT66121_HDMI_MODE_REG, 0);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_CLK_BANK_REG,
+				  IT66121_CLK_BANK_PWROFF_TXCLK,
+				  IT66121_CLK_BANK_PWROFF_TXCLK);
+	if (ret)
+		return ret;
+	ret = it66121_configure_input(dev);
+	if (ret)
+		return ret;
+	ret = it66121_configure_afe(dev);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_CLK_BANK_REG,
+				  IT66121_CLK_BANK_PWROFF_TXCLK, 0);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_AV_MUTE_REG,
+				  IT66121_AV_MUTE_ON, 0);
+	if (ret)
+		return ret;
+
+	return dm_i2c_reg_write(dev, IT66121_PKT_GEN_CTRL_REG, 0);
+}
+
+static int it66121_check_attached(struct udevice *dev)
+{
+	int val = dm_i2c_reg_read(dev, IT66121_SYS_STATUS_REG);
+
+	if (val < 0)
+		return val;
+
+	return val & IT66121_SYS_STATUS_HPDETECT ? 0 : -ENOTCONN;
+}
+
+static int it66121_power_on(struct udevice *dev)
+{
+	int ret;
+
+	ret = it66121_update_bits(dev, IT66121_CLK_BANK_REG,
+				  IT66121_CLK_BANK_PWROFF_RCLK, 0);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_INT_REG,
+				  IT66121_INT_TX_CLK_OFF, 0);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_AFE_DRV_REG,
+				  IT66121_AFE_DRV_PWD | IT66121_AFE_DRV_RST, 0);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_AFE_XP_REG,
+				  IT66121_AFE_XP_PWDI | IT66121_AFE_XP_PWDPLL |
+				  IT66121_AFE_XP_RESETB,
+				  IT66121_AFE_XP_RESETB);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_AFE_IP_REG,
+				  IT66121_AFE_IP_PWDPLL | IT66121_AFE_IP_RESETB,
+				  IT66121_AFE_IP_RESETB);
+	if (ret)
+		return ret;
+	ret = it66121_update_bits(dev, IT66121_SW_RST_REG,
+				  IT66121_SW_RST_REF, IT66121_SW_RST_REF);
+	if (ret)
+		return ret;
+
+	mdelay(50);
+	return 0;
+}
+
+static int it66121_probe(struct udevice *dev)
+{
+	struct video_bridge_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct it66121_priv *priv = dev_get_priv(dev);
+	ofnode endpoint;
+	u16 device_id, vendor_id;
+	int i, ret, val;
+
+	for (i = 0; i < ARRAY_SIZE(it66121_supply_names); i++) {
+		ret = device_get_supply_regulator(dev, it66121_supply_names[i],
+						  &priv->supplies[i]);
+		if (ret) {
+			dev_err(dev, "missing %s (%d)\n",
+				it66121_supply_names[i], ret);
+			return ret;
+		}
+		ret = regulator_set_enable_if_allowed(priv->supplies[i], true);
+		if (ret) {
+			dev_err(dev, "failed to enable %s (%d)\n",
+				it66121_supply_names[i], ret);
+			return ret;
+		}
+	}
+
+	if (uc_priv->reset.dev) {
+		ret = dm_gpio_set_value(&uc_priv->reset, true);
+		if (ret)
+			return ret;
+		mdelay(20);
+		ret = dm_gpio_set_value(&uc_priv->reset, false);
+		if (ret)
+			return ret;
+		mdelay(20);
+	}
+
+	val = dm_i2c_reg_read(dev, IT66121_VENDOR_ID0_REG);
+	if (val < 0)
+		return val;
+	vendor_id = val;
+	val = dm_i2c_reg_read(dev, IT66121_VENDOR_ID1_REG);
+	if (val < 0)
+		return val;
+	vendor_id |= val << 8;
+	val = dm_i2c_reg_read(dev, IT66121_DEVICE_ID0_REG);
+	if (val < 0)
+		return val;
+	device_id = val;
+	val = dm_i2c_reg_read(dev, IT66121_DEVICE_ID1_REG);
+	if (val < 0)
+		return val;
+	device_id |= (val & IT66121_DEVICE_ID1_MASK) << 8;
+	if (vendor_id != IT66121_VENDOR_ID || device_id != IT66121_DEVICE_ID) {
+		dev_err(dev, "unexpected chip ID %04x:%04x\n",
+			vendor_id, device_id);
+		return -ENODEV;
+	}
+
+	endpoint = ofnode_graph_get_endpoint_by_regs(dev_ofnode(dev), 0, -1);
+	if (!ofnode_valid(endpoint))
+		return -EINVAL;
+	priv->bus_width = ofnode_read_u32_default(endpoint, "bus-width", 24);
+	if (priv->bus_width != 12 && priv->bus_width != 24) {
+		dev_err(dev, "invalid bus width %u\n", priv->bus_width);
+		return -EINVAL;
+	}
+
+	ret = it66121_power_on(dev);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "IT66121 video bridge detected\n");
+	return 0;
+}
+
+static const struct video_bridge_ops it66121_ops = {
+	.attach = it66121_attach,
+	.check_attached = it66121_check_attached,
+	.get_display_timing = it66121_get_display_timing,
+	.read_edid = it66121_read_edid,
+};
+
+static const struct udevice_id it66121_ids[] = {
+	{ .compatible = "ite,it66121" },
+	{ }
+};
+
+U_BOOT_DRIVER(it66121) = {
+	.name = "ite_it66121",
+	.id = UCLASS_VIDEO_BRIDGE,
+	.of_match = it66121_ids,
+	.probe = it66121_probe,
+	.ops = &it66121_ops,
+	.priv_auto = sizeof(struct it66121_priv),
+};
